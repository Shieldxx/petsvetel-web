# Cloudflare Workers static assets headers.
# HTML keeps the default short cache so a new video shows up right after the deploy.
# script-src allows the Cloudflare Web Analytics beacon; the player loads only from youtube-nocookie.com.
# Referrer-Policy must send the origin: YouTube embeds refuse to play without a Referer.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-src https://www.youtube-nocookie.com; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests

# Fingerprinted Astro assets: a content change means a new file name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Preview host must not compete with petsvetel.cz in search.
https://petsvetel-web.davkohout.workers.dev/*
  X-Robots-Tag: noindex
