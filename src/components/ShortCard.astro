---
import { Picture } from 'astro:assets';
import { fitWidths, thumbFor } from '../lib/thumbs.ts';
import type { Video } from '../lib/types.ts';
import { nbsp } from '../lib/typography.ts';

interface Props {
  video: Video;
}

const { video } = Astro.props;
const thumb = thumbFor(video.thumb);
---
<li>
  <a class="short__link" href={`https://www.youtube.com/shorts/${video.id}`}>
    <span class="short__media">
      {
        thumb && (
          <Picture
            src={thumb}
            formats={['avif', 'webp']}
            alt=""
            widths={fitWidths([180, 270, 360, 540], thumb.width)}
            sizes="(min-width: 1120px) 170px, (min-width: 640px) 30vw, 45vw"
          />
        )
      }
    </span>
    <span class="short__title">{nbsp(video.title)}</span>
  </a>
</li>

<style>
  .short__link {
    display: block;
    text-decoration: none;
  }
  .short__media {
    display: block;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background: var(--bg-raised);
    border-radius: var(--radius);
  }
  .short__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .short__title {
    display: block;
    margin-top: 8px;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .short__link:hover .short__title {
    text-decoration: underline;
  }
</style>
