---
import type { Series } from '../lib/types.ts';
import { nbsp } from '../lib/typography.ts';

interface Props {
  items: Series[];
}

const { items } = Astro.props;
---
{
  items.length > 0 && (
    <section class="section" id="serie" aria-labelledby="serie-title">
      <div class="container">
        <h2 id="serie-title" class="section__title">Série</h2>
        <ul class="series-grid">
          {items.map((s) => (
            <li class="series">
              <h3 class="series__title">
                <a href={`https://www.youtube.com/playlist?list=${s.playlistId}`}>{s.title}</a>
              </h3>
              <p class="series__text">{nbsp(s.description)}</p>
              {s.archive && <span class="badge">Archiv</span>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .series-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .series {
    position: relative;
    padding: 20px 20px 20px 24px;
    background: var(--bg-raised);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
  }
  .series__title {
    margin: 0 0 8px;
    font: italic 700 1.5rem / 1.15 var(--font-display);
    text-transform: uppercase;
  }
  .series__title a {
    text-decoration: none;
  }
  /* the whole card is clickable */
  .series__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .series:hover .series__title a {
    text-decoration: underline;
  }
  .series__text {
    margin: 0 0 8px;
    color: var(--text-muted);
  }
</style>
