---
import Logomark from '../assets/brand/logomark.svg';
import type { NavLink } from '../lib/types.ts';

interface Props {
  links: NavLink[];
}

const { links } = Astro.props;
---
<header class="nav">
  <div class="container nav__inner">
    <a class="nav__home" href="/" aria-label="Pět světel, úvodní stránka">
      <Logomark aria-hidden="true" />
    </a>
    {
      links.length > 0 && (
        <nav aria-label="Hlavní navigace">
          <ul class="nav__links">
            {links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 5;
    background: rgb(28 28 30 / 0.94);
    border-bottom: 1px solid var(--line);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
  }
  .nav__home {
    display: block;
    padding-block: 12px;
  }
  .nav__home :global(svg) {
    width: 56px;
    height: auto;
  }
  .nav__links {
    display: flex;
    gap: clamp(16px, 4vw, 32px);
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 600;
  }
  .nav__links a {
    display: inline-block;
    padding-block: 12px;
    text-decoration: none;
  }
  .nav__links a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
  }
</style>
