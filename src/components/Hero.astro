---
import { Picture } from 'astro:assets';
import Logomark from '../assets/brand/logomark.svg';
import { site } from '../config.ts';
import { fitWidths, thumbFor } from '../lib/thumbs.ts';
import type { Video } from '../lib/types.ts';
import { nbsp } from '../lib/typography.ts';

interface Props {
  video: Video | null;
}

const { video } = Astro.props;
const thumb = thumbFor(video?.thumb ?? null);
---
<section class="hero" aria-labelledby="hero-title">
  <div class:list={['container', 'hero__inner', { 'hero__inner--player': Boolean(video) }]}>
    <div class="hero__brand">
      <h1 id="hero-title" class="hero__title">Pět světel</h1>
      <Logomark class="hero__mark" aria-hidden="true" />
      <p class="hero__tagline">{nbsp(site.tagline)}</p>
      <a class="button" href={site.subscribeUrl}>Odebírat na YouTube</a>
    </div>
    {
      video && (
        <div class="hero__player" data-player data-video-id={video.id} data-title={video.title}>
          <a class="player__link" href={`https://www.youtube.com/watch?v=${video.id}`}>
            {thumb && (
              <Picture
                src={thumb}
                formats={['avif', 'webp']}
                alt=""
                widths={fitWidths([480, 960, 1280], thumb.width)}
                sizes="(min-width: 900px) 640px, calc(100vw - 32px)"
                loading="eager"
                fetchpriority="high"
              />
            )}
            <span class="player__play" aria-hidden="true">
              <svg viewBox="0 0 72 72" width="72" height="72">
                <circle cx="36" cy="36" r="36" fill="#D9141C" />
                <path d="M29 22v28l22-14z" fill="#fff" />
              </svg>
            </span>
            <span class="visually-hidden">Přehrát video {video.title}</span>
          </a>
          <p class="player__title">{nbsp(video.title)}</p>
          <p class="player__note">
            Přehrání načte video z YouTube (Google), viz <a href="/soukromi">Soukromí</a>.
          </p>
        </div>
      )
    }
  </div>
</section>
{video && <script is:inline src="/player.js" defer></script>}

<style>
  .hero {
    padding-block: clamp(24px, 6vw, 64px);
  }
  .hero__inner {
    display: grid;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero__inner--player {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }
    .hero__inner--player .hero__player {
      grid-column: 1;
      grid-row: 1;
    }
    .hero__inner--player .hero__brand {
      grid-column: 2;
      grid-row: 1;
    }
  }
  .hero__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .hero__title {
    margin: 0;
    color: var(--text);
    font: italic 700 clamp(2.75rem, 7vw, 4.25rem) / 0.95 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .hero__brand :global(.hero__mark) {
    width: min(320px, 92%);
    height: auto;
  }
  .hero__tagline {
    max-width: 30ch;
    margin: 4px 0 0;
    font-size: 1.1875rem;
    line-height: 1.4;
  }
  .player__link {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-raised);
    border-radius: var(--radius);
  }
  .player__link :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .player__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .player__play svg {
    width: clamp(56px, 10vw, 80px);
    height: auto;
    filter: drop-shadow(0 4px 12px rgb(0 0 0 / 0.5));
    transition: transform 0.15s ease;
  }
  .player__link:hover .player__play svg,
  .player__link:focus-visible .player__play svg {
    transform: scale(1.08);
  }
  .player__title {
    margin: 14px 0 4px;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .player__note {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .player__play svg {
      transition: none;
    }
  }
</style>
